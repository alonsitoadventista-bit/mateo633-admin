# URL pública del backend (mateo633-backend).
#
# Desarrollo local: dejar VACÍO. El panel usará el proxy de Vite
# (ver vite.config.js), que reenvía /admin, /uploads y /health a
# http://localhost:3000.
#
# Producción: la URL completa del backend desplegado, sin barra final.
#   VITE_API_URL=https://api.mateo633.com
VITE_API_URL=

# Opcional (solo dev): sobrescribe el destino del proxy si el backend
# no corre en http://localhost:3000.
# VITE_DEV_BACKEND=http://localhost:3000
